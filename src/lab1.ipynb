import os
import hashlib
import numpy as np
from PIL import Image
from Crypto.Cipher import AES
from Crypto.Util.Padding import pad, unpad
import matplotlib.pyplot as plt
import csv
import json

# ==========================================
# 1. Вспомогательные функции
# ==========================================
def load_image(path):
    return np.array(Image.open(path).convert('RGB'), dtype=np.uint8)

def save_image(data, path):
    Image.fromarray(data).save(path)

def get_sha256(data):
    """Возвращает SHA-256 хэш для массива байтов."""
    return hashlib.sha256(data.tobytes()).hexdigest()

# ==========================================
# 2. Потоковый XOR (xorshift32)
# ==========================================
class XorShift32:
    def __init__(self, seed):
        if seed == 0: seed = 1
        self.state = seed & 0xFFFFFFFF

    def next_byte(self):
        x = self.state
        x ^= (x << 13) & 0xFFFFFFFF
        x ^= (x >> 17)
        x ^= (x << 5) & 0xFFFFFFFF
        self.state = x & 0xFFFFFFFF
        return x & 0xFF

def xor_encrypt_decrypt(image_data, key_str):
    seed = int(hashlib.sha256(key_str.encode()).hexdigest(), 16) & 0xFFFFFFFF
    prng = XorShift32(seed)
    flat_data = image_data.flatten()
    keystream = np.array([prng.next_byte() for _ in range(len(flat_data))], dtype=np.uint8)
    result = flat_data ^ keystream
    return result.reshape(image_data.shape)

# ==========================================
# 3. AES-256 (ECB и CBC) - ПОЛНАЯ РЕАЛИЗАЦИЯ
# ==========================================
def aes_encrypt_bytes(image_data, key_str, mode='ECB'):
    key = hashlib.sha256(key_str.encode()).digest() # 32 байта = AES-256
    flat_data = image_data.tobytes()
    
    if mode == 'ECB':
        cipher = AES.new(key, AES.MODE_ECB)
        return cipher.encrypt(pad(flat_data, AES.block_size))
    
    elif mode == 'CBC':
        iv = os.urandom(16) #b'1234567890123456' os.urandom(16) # Случайный IV
        cipher = AES.new(key, AES.MODE_CBC, iv)
        return iv + cipher.encrypt(pad(flat_data, AES.block_size)) # Сохраняем IV в начале

def aes_decrypt_bytes(encrypted_data, key_str, original_shape, mode='ECB'):
    key = hashlib.sha256(key_str.encode()).digest()
    
    if mode == 'ECB':
        cipher = AES.new(key, AES.MODE_ECB)
        decrypted = unpad(cipher.decrypt(encrypted_data), AES.block_size)
        return np.frombuffer(decrypted, dtype=np.uint8).reshape(original_shape)
        
    elif mode == 'CBC':
        iv = encrypted_data[:16]
        ciphertext = encrypted_data[16:]
        cipher = AES.new(key, AES.MODE_CBC, iv)
        decrypted = unpad(cipher.decrypt(ciphertext), AES.block_size)
        return np.frombuffer(decrypted, dtype=np.uint8).reshape(original_shape)

# ==========================================
# 4. Статистические метрики и NPCR/UACI
# ==========================================
def calc_entropy(image_data):
    flat = image_data.flatten()
    _, counts = np.unique(flat, return_counts=True)
    probabilities = counts / len(flat)
    return -np.sum(probabilities * np.log2(probabilities))

def calc_correlation(image_data):
    channel = image_data[:, :, 0].astype(float)
    corr_h = np.corrcoef(channel[:, :-1].flatten(), channel[:, 1:].flatten())[0, 1]
    corr_v = np.corrcoef(channel[:-1, :].flatten(), channel[1:, :].flatten())[0, 1]
    return corr_h, corr_v

def calc_npcr_uaci(img1, img2):
    c1 = img1.flatten().astype(np.int16)
    c2 = img2.flatten().astype(np.int16)
    npcr = np.sum(c1 != c2) / len(c1) * 100
    uaci = np.mean(np.abs(c1 - c2) / 255.0) * 100
    return npcr, uaci

def plot_histograms(images, titles, filename):
    fig, axes = plt.subplots(2, 2, figsize=(10, 6))
    axes = axes.flatten()
    for i, (img, title) in enumerate(zip(images, titles)):
        data = img[:, :, 0].flatten()
        axes[i].hist(data, bins=256, range=(0, 255), color='red', alpha=0.7)
        axes[i].set_title(title)
    plt.tight_layout()
    plt.savefig(filename)
    plt.close()

# ==========================================
# 5. Основной запуск
# ==========================================
if __name__ == "__main__":
    IMG_PATH = 'yinyang.png' # <--- УКАЖИТЕ ИМЯ ВАШЕЙ КАРТИНКИ
    KEY = "MySKey123"
    
    os.makedirs('CryptoPic/results', exist_ok=True)
    
    print(f"--- Обработка изображения: {IMG_PATH} ---")
    orig_img = load_image(IMG_PATH)
    original_shape = orig_img.shape
    
    # 1. Шифрование
    print("[1/4] Шифрование (XOR, AES-256 ECB, AES-256 CBC)...")
    xor_img = xor_encrypt_decrypt(orig_img, KEY)
    
    ecb_enc_bytes = aes_encrypt_bytes(orig_img, KEY, mode='ECB')
    cbc_enc_bytes = aes_encrypt_bytes(orig_img, KEY, mode='CBC')
    
    with open('CryptoPic/results/ecb_enc.bin', 'wb') as f: f.write(ecb_enc_bytes)
    with open('CryptoPic/results/cbc_enc.bin', 'wb') as f: f.write(cbc_enc_bytes)
    
    # meta.json
    meta_data = {
        "source_image": IMG_PATH,
        "algorithm": "AES-256",
        "cbc_iv_hex": cbc_enc_bytes[:16].hex()
    }
    with open('CryptoPic/results/meta.json', 'w', encoding='utf-8') as f:
        json.dump(meta_data, f, indent=4)
    
    # Картинки для визуализации
    ecb_img_display = np.frombuffer(ecb_enc_bytes[:np.prod(original_shape)], dtype=np.uint8).reshape(original_shape)
    cbc_img_display = np.frombuffer(cbc_enc_bytes[16:16+np.prod(original_shape)], dtype=np.uint8).reshape(original_shape)
    
    save_image(xor_img, 'CryptoPic/results/xor_enc.png')
    save_image(ecb_img_display, 'CryptoPic/results/ecb_enc.png')
    save_image(cbc_img_display, 'CryptoPic/results/cbc_enc.png')
    
    # 2. Проверка обратимости
    print("\n[2/4] Проверка обратимости (SHA-256)...")
    xor_dec = xor_encrypt_decrypt(xor_img, KEY)
    ecb_dec = aes_decrypt_bytes(ecb_enc_bytes, KEY, original_shape, mode='ECB')
    cbc_dec = aes_decrypt_bytes(cbc_enc_bytes, KEY, original_shape, mode='CBC')
    
    hash_orig = get_sha256(orig_img)
    print(f"    Оригинал:      {hash_orig[:16]}...")
    print(f"    XOR восст:     {get_sha256(xor_dec)[:16]}... | Совпадает: {get_sha256(xor_dec) == hash_orig}")
    print(f"    AES-ECB восст: {get_sha256(ecb_dec)[:16]}... | Совпадает: {get_sha256(ecb_dec) == hash_orig}")
    print(f"    AES-CBC восст: {get_sha256(cbc_dec)[:16]}... | Совпадает: {get_sha256(cbc_dec) == hash_orig}")

    # 3. Расчет метрик и создание CSV
    print("\n[3/4] Расчет метрик...")
    images = [orig_img, xor_img, ecb_img_display, cbc_img_display]
    names = ["Original", "XOR", "AES-ECB", "AES-CBC"]
    
    metrics_data = [["Method", "Entropy", "Corr_H", "Corr_V"]]
    for name, img in zip(names, images):
        ent = calc_entropy(img)
        ch, cv = calc_correlation(img)
        metrics_data.append([name, f"{ent:.4f}", f"{ch:.4f}", f"{cv:.4f}"])
        print(f"    {name:<10} | Entropy: {ent:.4f} | Corr H: {ch:.4f} | Corr V: {cv:.4f}")
        
    # NPCR/UACI (Эксперимент с ключом)
    print("\n--- Эксперимент с изменением ключа (NPCR/UACI) ---")
    changed_key = KEY[:-1] + ('A' if KEY[-1] != 'A' else 'B') #"MySKey123" KEY[:-1] + ('A' if KEY[-1] != 'A' else 'B')
    cbc_changed_bytes = aes_encrypt_bytes(orig_img, changed_key, mode='CBC')
    cbc_changed_display = np.frombuffer(cbc_changed_bytes[16:16+np.prod(original_shape)], dtype=np.uint8).reshape(original_shape)
    
    npcr, uaci = calc_npcr_uaci(cbc_img_display, cbc_changed_display)
    print(f"    NPCR (AES-CBC): {npcr:.2f}%")
    print(f"    UACI (AES-CBC): {uaci:.2f}%")
    
    # Дописываем NPCR/UACI в CSV
    metrics_data.append(["NPCR (AES-CBC)", f"{npcr:.2f}%", "", ""])
    metrics_data.append(["UACI (AES-CBC)", f"{uaci:.2f}%", "", ""])
        
    with open('CryptoPic/results/metrics.csv', 'w', newline='', encoding='utf-8') as f:
        writer = csv.writer(f)
        writer.writerows(metrics_data)
        
    print("\n    Файл metrics.csv успешно создан (с NPCR и UACI).")
    
    # 4. Построение графиков
    print("\n[4/4] Построение гистограмм...")
    plot_histograms(images, names, 'CryptoPic/results/histograms.png')
    print("    Графики сохранены.")
    
    print("\n=== ВСЕ ЭТАПЫ УСПЕШНО ЗАВЕРШЕНЫ ===")