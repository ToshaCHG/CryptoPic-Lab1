import os
import json
import hashlib
import numpy as np
from PIL import Image
from Crypto.Cipher import AES
from Crypto.Util.Padding import pad, unpad
import matplotlib.pyplot as plt

# ==========================================
# 1. Вспомогательные функции
# ==========================================
def load_image(path):
    img = Image.open(path).convert('RGB')
    return np.array(img, dtype=np.uint8)

def save_image(data, path):
    Image.fromarray(data).save(path)

def get_sha256(data):
    return hashlib.sha256(data.tobytes()).hexdigest()

# ==========================================
# 2. Потоковый XOR (xorshift32)
# ==========================================
class XorShift32:
    def __init__(self, seed):
        if seed == 0: seed = 1
        self.state = seed & 0xFFFFFFFF

    def next_byte(self):
        x = self.state
        x ^= (x << 13) & 0xFFFFFFFF
        x ^= (x >> 17)
        x ^= (x << 5) & 0xFFFFFFFF
        self.state = x & 0xFFFFFFFF
        return x & 0xFF

def xor_encrypt_decrypt(image_data, key_str):
    seed = int(hashlib.sha256(key_str.encode()).hexdigest(), 16) & 0xFFFFFFFF
    prng = XorShift32(seed)
    flat_data = image_data.flatten()
    keystream = np.array([prng.next_byte() for _ in range(len(flat_data))], dtype=np.uint8)
    result = flat_data ^ keystream
    return result.reshape(image_data.shape)

# ==========================================
# 3. AES (ECB и CBC)
# ==========================================
def aes_encrypt_decrypt(image_data, key_str, mode='ECB', iv_str=None):
    key = hashlib.sha256(key_str.encode()).digest()
    flat_data = image_data.tobytes()
    
    if mode == 'ECB':
        cipher = AES.new(key, AES.MODE_ECB)
        encrypted = cipher.encrypt(pad(flat_data, AES.block_size))
        return np.frombuffer(encrypted, dtype=np.uint8)
    
    elif mode == 'CBC':
        iv = hashlib.md5(iv_str.encode()).digest()
        cipher = AES.new(key, AES.MODE_CBC, iv)
        encrypted = cipher.encrypt(pad(flat_data, AES.block_size))
        return np.frombuffer(encrypted, dtype=np.uint8)

def aes_decrypt(encrypted_data, key_str, original_shape, mode='ECB', iv_str=None):
    key = hashlib.sha256(key_str.encode()).digest()
    flat_data = encrypted_data.tobytes()
    
    if mode == 'ECB':
        cipher = AES.new(key, AES.MODE_ECB)
        decrypted = unpad(cipher.decrypt(flat_data), AES.block_size)
        return np.frombuffer(decrypted, dtype=np.uint8).reshape(original_shape)
        
    elif mode == 'CBC':
        iv = hashlib.md5(iv_str.encode()).digest()
        cipher = AES.new(key, AES.MODE_CBC, iv)
        decrypted = unpad(cipher.decrypt(flat_data), AES.block_size)
        return np.frombuffer(decrypted, dtype=np.uint8).reshape(original_shape)

# ==========================================
# 4. Статистические метрики
# ==========================================
def calc_entropy(image_data):
    flat = image_data.flatten()
    _, counts = np.unique(flat, return_counts=True)
    probabilities = counts / len(flat)
    return -np.sum(probabilities * np.log2(probabilities))

def calc_correlation(image_data):
    channel = image_data[:, :, 0].astype(float)
    corr_h = np.corrcoef(channel[:, :-1].flatten(), channel[:, 1:].flatten())[0, 1]
    corr_v = np.corrcoef(channel[:-1, :].flatten(), channel[1:, :].flatten())[0, 1]
    return corr_h, corr_v

def calc_npcr_uaci(img1, img2):
    c1 = img1.flatten().astype(np.int16)
    c2 = img2.flatten().astype(np.int16)
    npcr = np.sum(c1 != c2) / len(c1) * 100
    uaci = np.mean(np.abs(c1 - c2) / 255.0) * 100
    return npcr, uaci

def plot_histograms(images, titles, filename):
    fig, axes = plt.subplots(2, 2, figsize=(10, 6))
    axes = axes.flatten()
    for i, (img, title) in enumerate(zip(images, titles)):
        data = img[:, :, 0].flatten()
        axes[i].hist(data, bins=256, range=(0, 255), color='red', alpha=0.7)
        axes[i].set_title(title)
    plt.tight_layout()
    plt.savefig(filename)
    plt.close() # Закрываем, чтобы не засорять память

# ==========================================
# 5. Функция полного анализа
# ==========================================
def full_analysis(img_path, img_name):
    print(f"\n{'='*40}\nАнализ: {img_name}\n{'='*40}")
    KEY = "MySuperSecretKey123"
    IV = "MyInitializationVector"
    
    os.makedirs('CryptoPic/imgs', exist_ok=True)
    os.makedirs('CryptoPic/results', exist_ok=True)
    
    try:
        orig_img = load_image(img_path)
    except Exception as e:
        print(f"Ошибка загрузки {img_path}: {e}")
        return
        
    original_shape = orig_img.shape
    save_image(orig_img, f'CryptoPic/imgs/{img_name}')
    
    xor_img = xor_encrypt_decrypt(orig_img, KEY)
    ecb_img_flat = aes_encrypt_decrypt(orig_img, KEY, mode='ECB')
    cbc_img_flat = aes_encrypt_decrypt(orig_img, KEY, mode='CBC', iv_str=IV)
    
    ecb_img_display = ecb_img_flat[:np.prod(original_shape)].reshape(original_shape)
    cbc_img_display = cbc_img_flat[:np.prod(original_shape)].reshape(original_shape)
    
    save_image(xor_img, f'CryptoPic/results/{img_name}_xor_enc.png')
    save_image(ecb_img_display, f'CryptoPic/results/{img_name}_ecb_enc.png')
    save_image(cbc_img_display, f'CryptoPic/results/{img_name}_cbc_enc.png')
    
    meta_data = {"source_image": img_name, "cbc_iv": IV}
    with open(f'CryptoPic/results/{img_name}_meta.json', 'w') as f:
        json.dump(meta_data, f, indent=4)
        
    images = [orig_img, xor_img, ecb_img_display, cbc_img_display]
    names = ["Исходное", "XOR", "AES-ECB", "AES-CBC"]
    
    print(f"{'Метод':<10} | {'Энтропия':<10} | {'Corr H':<10} | {'Corr V':<10}")
    print("-" * 50)
    for name, img in zip(names, images):
        print(f"{name:<10} | {calc_entropy(img):.4f}     | {calc_correlation(img)[0]:.4f}     | {calc_correlation(img)[1]:.4f}")
        
    # NPCR/UACI
    changed_key = KEY[:-1] + ('A' if KEY[-1] != 'A' else 'B')
    cbc_changed = aes_encrypt_decrypt(orig_img, changed_key, mode='CBC', iv_str=IV)
    cbc_changed_disp = cbc_changed[:np.prod(original_shape)].reshape(original_shape)
    npcr, uaci = calc_npcr_uaci(cbc_img_display, cbc_changed_disp)
    print(f"\nNPCR: {npcr:.2f}% | UACI: {uaci:.2f}%")
        
    plot_histograms(images, names, f'CryptoPic/results/{img_name}_histograms.png')

